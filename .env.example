# ==============================================================================
# Graahak AI Backend - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values for your local development or deployment.

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
# Comma-separated allowed origins or single origin (e.g., frontend application)
CORS_ORIGIN=http://localhost:3000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=graahak_ai

# External Python FastAPI AI Service
# Endpoint and timeout for the downstream AI microservice
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=30000

# Document Upload & Storage Configuration (Multer)
# Maximum file size in bytes (10MB default) and target upload directory
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=10485760
